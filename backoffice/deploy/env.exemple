# Copier en /etc/backoffice.env sur le serveur (droits 600). Ne jamais committer le vrai fichier.
BO_MODE_ENVOI=test                 # passer à "reel" seulement après accord d'Avishay
BO_HOST=127.0.0.1                  # Caddy expose le tableau de bord en HTTPS
BO_PORT=8787
BO_DASHBOARD_PASSWORD=             # mot de passe long, choisi par Avishay
BO_INTAKE_TOKEN=                   # jeton des formulaires / webhooks entrants
BO_BASE=/var/lib/backoffice/backoffice.sqlite3
BO_DEPOT=/opt/agence-immo
BO_EMAIL_ALERTES=avi@levygoldman.com
BO_HEURE_RECAP=08:00

TELEGRAM_BOT_TOKEN=                # donné par @BotFather
TELEGRAM_CHAT_ID=                  # identifiant numérique d'Avishay (le bot le donne à /start) ; ancien nom TELEGRAM_OWNER_ID accepté

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_ADDRESS=                      # Gmail dédié aux alertes (ou SMTP_USER + SMTP_HOST pour un autre fournisseur)
SMTP_USER=                         # compte expéditeur des alertes
GMAIL_APP_PASSWORD=                 # mot de passe d'application Gmail (pas le mot de passe du compte)
SMTP_PASSWORD=                     # mot de passe d'application (pas le mot de passe du compte)
SMTP_FROM=

ANTHROPIC_API_KEY=                 # seulement après accord sur le budget, avec plafond de dépense

# Auditeur ChatGPT (second avis sur les contenus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
